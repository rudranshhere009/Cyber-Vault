# OCR Chatbot AI provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# For Vercel web deploy, set these same keys in Vercel Project -> Settings -> Environment Variables
# Optional: cap raw file base64 chars sent to model for non-image files
GROQ_FILE_BASE64_MAX_CHARS=120000

# Optional OCR vision provider (image/pdf page OCR boost)
GOOGLE_VISION_API_KEY=

# Optional dev override
# VITE_DEV_SERVER_URL=http://localhost:5173
